{
  "name": "zerogpu-api",
  "version": "1.0.0",
  "description": "Official ZeroGPU API TypeScript client (responses, chat completions, moderations, embeddings, audio). Published from ZeroGPU API SDKs.",
  "license": "MIT",
  "homepage": "https://docs.zerogpu.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerogpu/SDK.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/zerogpu/SDK/issues"
  },
  "keywords": [
    "zerogpu",
    "ai",
    "sdk",
    "inference",
    "typescript",
    "nodejs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/copy-cjs-types.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
